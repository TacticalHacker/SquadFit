# apps/web — copy to apps/web/.env.local (and set the same names in Amplify Hosting).
# All server-only: nothing here is exposed to the browser.
# Values come from the CDK stack outputs of `pnpm deploy:dev`.
API_URL=https://xxxxxxxx.execute-api.ap-south-1.amazonaws.com
COGNITO_REGION=ap-south-1
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Feature 012 (optional): iCloud link of the "SquadFit" Shortcut; the Settings button is hidden when unset.
# HEALTH_SHORTCUT_URL=https://www.icloud.com/shortcuts/xxxxxxxx

# infra — used by CDK and the admin CLI when deploying
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=ap-south-1

# Local testing only: point the web server at a fake Cognito instead of AWS.
# COGNITO_ENDPOINT=http://localhost:4010/

# Feature 004 (AI Coach / MCP) needs no new environment variables: the /mcp Lambda uses TABLE_NAME and
# per-member keys issued with `pnpm admin ai-key issue <username>`. Never put keys in env vars.
